{
  "name": "tokenpulse",
  "productName": "TokenPulse",
  "version": "2.21.0",
  "description": "Claude, Codex and WorkBuddy token usage and cost monitor",
  "author": "TokenPulse",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node scripts/ensure-electron.cjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "node scripts/ensure-electron.cjs",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icons": "node scripts/gen-icons.mjs && electron scripts/render-icons.cjs",
    "quota": "node src/bridge/quota.cjs",
    "predist": "node scripts/ensure-electron.cjs",
    "postdist": "node scripts/checksums.cjs",
    "dist": "electron-vite build && electron-builder --win -c.electronDist=node_modules/electron/dist --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
